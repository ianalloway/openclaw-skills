    "openclaw.plugin.json",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.9"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.9"
    },
    "install": {
      "minHostVersion": ">=2026.10.9"
    }
  }
