{
  "name": "openclaw-theme-neon",
  "version": "0.2.0",
  "description": "Neon cyberpunk appearance themes for OpenClaw (plugin themes for the Control UI).",
  "type": "module",
  "license": "MIT",
  "author": "Ian Alloway",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianalloway/openclaw-theme-neon.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "theme",
    "cyberpunk",
    "neon",
    "dracula"
  ],
